    {
      "name": "7) A confirme ami accepte",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Liste amis A OK', function () {",
              "  pm.expect(pm.response.code).to.eql(200);",
              "});",
              "const json = pm.response.json();",
              "const accepted = json.acceptedFriends || json.AcceptedFriends || [];",
              "const friend = accepted.find(x => ((x.friendId ?? x.FriendId) + '') === (pm.collectionVariables.get('userIdB') + ''));",
              "pm.test('B est bien dans les amis de A', function () {",
              "  pm.expect(friend).to.not.be.undefined;",
              "});",
              "if (friend) {",
              "  pm.collectionVariables.set('friendshipId', friend.id ?? friend.Id);",
              "}"
            ]
          }
        }
