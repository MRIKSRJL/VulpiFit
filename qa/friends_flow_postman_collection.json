      "name": "1) Login Joueur A (RenardAlpha)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login A OK', function () {",
              "  pm.expect(pm.response.code).to.eql(200);",
              "});",
              "const json = pm.response.json();",
              "pm.collectionVariables.set('tokenA', json.Token || json.token);",
              "pm.collectionVariables.set('userIdA', (json.User || json.user).Id ?? (json.User || json.user).id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"pseudo\": \"{{pseudoA}}\",\n  \"password\": \"{{passwordA}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/Users/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "Users",
            "login"
          ]
        }
      }
    },
