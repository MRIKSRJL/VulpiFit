    {
      "name": "5) B recupere demandes en attente",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Liste demandes B OK', function () {",
              "  pm.expect(pm.response.code).to.eql(200);",
              "});",
              "const json = pm.response.json();",
              "const pending = json.pendingReceived || json.PendingReceived || [];",
              "const req = pending.find(x => ((x.fromUserId ?? x.FromUserId) + '') === (pm.collectionVariables.get('userIdA') + ''));",
              "pm.test('Demande de A presente pour B', function () {",
              "  pm.expect(req).to.not.be.undefined;",
              "});",
              "if (req) {",
              "  pm.collectionVariables.set('friendshipId', req.id ?? req.Id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{tokenB}}"
          },
