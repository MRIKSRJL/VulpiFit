    {
      "name": "3) A recherche 'Beta'",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Recherche OK', function () {",
              "  pm.expect(pm.response.code).to.eql(200);",
              "});",
              "const users = pm.response.json();",
              "pm.test('RenardBeta apparait dans les resultats', function () {",
              "  const hasBeta = users.some(u => (u.Pseudo || u.pseudo || '').toLowerCase().includes('beta'));",
              "  pm.expect(hasBeta).to.be.true;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{tokenA}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/Friends/search?pseudo=Beta",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "Friends",
            "search"
          ],
          "query": [
            {
              "key": "pseudo",
              "value": "Beta"
            }
          ]
        }
